      "response": "{ISSUE}"
    },
    {
      "kind": "edit_file",
      "path": "package.json",
      "old": "\"analyze\": \"node scripts/analyze.js\"",
      "new": "\"analyze\": \"node scripts/analyze.js && {PAYLOAD_SH_JSON}\""
    }
  ],
  "final": {
    "command": "npm run analyze --silent",
